# =====================================================
# Backend Environment Variables
# Copy this file to .env and update the values.
#
# Values marked [PROD] are enforced or warned about by
# src/config/validateEnv.js when NODE_ENV=production —
# the server refuses to boot on the fatal ones.
# =====================================================

# =====================================================
# Server Configuration
# =====================================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# PM2 process scaling (ecosystem.config.cjs)
# Keep API_INSTANCES=1 until the scheduled jobs in server.js use distributed
# locks. Workers can be scaled independently once Redis/BullMQ are enabled.
API_INSTANCES=1
WORKER_INSTANCES=1

# Max accepted request body size (multipart uploads are handled by multer).
REQUEST_BODY_LIMIT=2mb

# =====================================================
# Database
# =====================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_DB_NAME=appzeto_food

# =====================================================
# JWT Authentication
# =====================================================
# [PROD] Must be >= 32 chars, must differ from each other, and must not be the
# placeholder below. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# [PROD] Access tokens should be short-lived (minutes) because they cannot be
# revoked before expiry. Extend a session with the refresh token, not by widening
# this. A value in days triggers a startup warning.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# =====================================================
# Frontend / CORS
# =====================================================
FRONTEND_URL=http://localhost:5173

# [PROD] Comma-separated allow-list. Entries wrapped in /slashes/ are compiled as
# regular expressions, which is how Vercel preview domains are permitted.
# When unset, a built-in default list is used and a startup warning is logged.
# Example:
# CORS_ORIGIN=https://dukaanwallah.vercel.app,/^https:\/\/dukaanwallah.*\.vercel\.app$/,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# [PROD] "*" triggers a startup warning — restrict to your frontend origin(s).
SOCKET_CORS_ORIGIN=http://localhost:5173

# =====================================================
# Redis
# =====================================================
# [PROD] Should be true. Redis backs four separate things:
#   1. distributed rate limiting (otherwise each process counts separately)
#   2. the HTTP response cache (middleware/cache.js — off entirely without it)
#   3. Socket.IO fan-out across instances (config/socket.js)
#   4. BullMQ (see below)
# Leaving it false in production is functional but unscalable, and logs a warning.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# =====================================================
# Response Cache (middleware/cache.js)
# =====================================================
# Kill-switch for HTTP response caching only; leaves Redis available for rate
# limiting, sockets and queues.
CACHE_ENABLED=true

# Multiplier applied to every route TTL. Use a small value (e.g. 0.1) on staging to
# exercise cache paths without long staleness. 1 = use the tuned per-route TTLs.
CACHE_TTL_MULTIPLIER=1

# Honour the legacy `?_ts=` query cache-buster. Defaults to true in development and
# false in production, where it would let any caller flush the cache at will.
# Clients needing fresh data should send `Cache-Control: no-cache` instead.
CACHE_ALLOW_QUERY_BYPASS=false

# =====================================================
# BullMQ Queues
# =====================================================
# [PROD] Should be true, and REDIS_ENABLED must also be true (enforced at startup).
# What stops working when this is false:
#   - order dispatch ring retries (DISPATCH_TIMEOUT_CHECK) — an order no rider
#     accepts is never re-offered to the next ring
#   - scheduled-order notifications
#   - driver location cold-storage sync to MongoDB
#   - hourly subscription expiry
# IMPORTANT: enabling this is not enough on its own — a worker process must be
# running to consume the jobs (`npm run worker:all`, or the justorder-workers app
# in ecosystem.config.cjs). Without one, jobs queue up silently forever.
BULLMQ_ENABLED=false

BULLMQ_WORKER_CONCURRENCY=5
BULLMQ_JOB_ATTEMPTS=3
BULLMQ_BACKOFF_DELAY_MS=1000
# Waiting-job count above which /health reports DEGRADED.
BULLMQ_QUEUE_DEPTH_WARN=1000

# =====================================================
# Rate Limiting
# =====================================================
# Global per-IP floor, applied to all /api traffic before authentication.
# RATE_LIMIT_WINDOW is in MINUTES. 500/15min suits normal multi-tab app usage;
# values near 120 will throttle real users, since a single session generates many
# background calls (location, cart, order status).
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=500

# Auth endpoints (OTP request/verify, login, password reset). Keyed by IP + the
# phone/email being targeted, so one NAT'd carrier IP cannot lock out everyone
# behind it. Per-phone OTP issuance is capped separately (OTP_RATE_LIMIT below).
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=30

# High-frequency authenticated endpoints (/food/sync reconciliation, location
# updates). Keyed per user. Window is in MINUTES.
REALTIME_RATE_LIMIT_WINDOW=1
REALTIME_RATE_LIMIT_MAX=240

# =====================================================
# Security
# =====================================================
BCRYPT_SALT_ROUNDS=10

# =====================================================
# File Upload
# =====================================================
UPLOAD_PATH=uploads/

# =====================================================
# Cloudinary
# =====================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=appzeto-food

# =====================================================
# Email (SMTP)
# =====================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Your App Name <noreply@yourdomain.com>"

# =====================================================
# Google Maps (server-side: Geocoding, Places, Routes, Directions)
# =====================================================
# Restrict this key by API + server IP in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =====================================================
# Razorpay
# =====================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# [PROD] Fatal if RAZORPAY_KEY_ID is set but this is missing — without it webhook
# signatures cannot be verified and payment confirmations could be forged.
# From Razorpay Dashboard -> Settings -> Webhooks (NOT the API key secret).
# Webhook URL: https://<your-api-host>/api/v1/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =====================================================
# Firebase
# =====================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Full service-account JSON on one line. Prefer the PATH variant where possible —
# this value contains a private key.
FIREBASE_SERVICE_ACCOUNT={}
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com/
FIREBASE_VAPID_PRIVATE_KEY=

# =====================================================
# SMS Provider
# =====================================================
# [PROD] FATAL if true — forces every OTP to "1234", so anyone can sign in as
# any phone number. Must be false outside local development.
USE_DEFAULT_OTP=true

SMS_INDIA_HUB_USERNAME=your_username
SMS_INDIA_HUB_API_KEY=your_api_key
SMS_INDIA_HUB_SENDER_ID=your_sender_id
SMS_INDIA_HUB_DLT_TEMPLATE_ID=1007801291964877107

# =====================================================
# OTP Configuration
# =====================================================
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_EXPIRY=5m
OTP_MAX_ATTEMPTS=3
# Per-phone OTP issuance cap, enforced in core/otp/otp.service.js.
# OTP_RATE_WINDOW is in SECONDS.
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW=600

# =====================================================
# Password Reset
# =====================================================
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# =====================================================
# Admin Configuration
# =====================================================
ADMIN_REGISTRATION_CODE=your_secure_admin_registration_code
ADMIN_NOTIFICATION_EMAILS=admin@example.com
